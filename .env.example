# =====================================================================
# grh-api — modèle de variables d'environnement (PAS de secrets ici)
# Copier vers .env en local, ou saisir les mêmes clés dans
# Render -> Service -> Environment (Dashboard, sans le fichier .env).
# =====================================================================

# --- Serveur -------------------------------------------------------------
# PORT : défini automatiquement par Render (ne pas le surcharger en prod)
PORT=3003

# --- Base de données Supabase --------------------------------------------
# URI copiée depuis Supabase Dashboard -> Settings / Connect -> Connection string
# (privilegier le mode « Session » du pooler si l'hosting n'a pas d'IPv6)
DATABASE_URL=postgresql://postgres:VOTRE_MDP@db.VOTRE_REF.supabase.co:5432/postgres?sslmode=require
DB_SSL=true
DB_DIALECT=postgres
DB_NAME=postgres

# --- CORS : origine du frontend autorisee --------------------------------
# Une ou plusieurs origines separees par des virgules (sans slash final).
# En production (Render) : definir cette variable dans le dashboard du service,
# le fichier .env n'etant pas deploye. Sans elle, CORS bloque le front deploye.
FRONTEND_URL=http://localhost:3001
# FRONTEND_URL=https://grh-web.vercel.app,http://localhost:3001

# --- Authentification JWT (openssl rand -hex 32 en production) -----------
JWT_SECRET=change_me

# --- Emails (Resend) — facultatif : sans clé, aucun envoi -----------------
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# --- Environnement --------------------------------------------------------
NODE_ENV=production
